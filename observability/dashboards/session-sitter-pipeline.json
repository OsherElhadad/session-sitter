    {
      "id": 29,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "sessionsitter"
      },
      "type": "table",
      "title": "Sessions in, practices out",
      "description": "Summed over the propose runs in the window. NOT a Sankey — a five-stage Sankey is a picture that looks like insight and conveys a table.\n\nThe interesting fact about this funnel is always WHERE IT NARROWS. A floor nothing clears and a replay nothing survives are both designed outcomes, and both look identical from the end of the pipe, which is what the refusal panel beside this one separates.\n\n`proposed` counts clause files written at `status: proposed`, which is inert: a proposed clause cannot decide, cannot be matched and cannot reach the prompt until a human accepts it in a pull request.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "sessionsitter"
          },
          "refId": "A",
          "expr": "kind:pipeline_run machine:~\"$machine\" stage:propose | stats sum(fresh) records_read, sum(shapes) shapes, sum(clusters) clusters, sum(considered) candidates_considered, sum(proposed) proposed, sum(retired) retirements",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "records_read",
                "destinationType": "number"
              },
              {
                "targetField": "shapes",
                "destinationType": "number"
              },
              {
                "targetField": "clusters",
                "destinationType": "number"
              },
              {
                "targetField": "candidates_considered",
                "destinationType": "number"
              },
              {
                "targetField": "proposed",
                "destinationType": "number"
              },
              {
                "targetField": "retirements",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
