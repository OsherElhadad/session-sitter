        "h": 13,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "sessionsitter"
          },
          "refId": "A",
          "expr": "kind:pipeline_run machine:~\"$machine\" | sort by (_time desc) | fields _time, machine, stage, trigger, exitReason, producedNothing, failed, fresh, shapes, clusters, considered, proposed, retired, held, refusalCount, refusals, replayN, replayChanged, rotated, durationMs",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "fresh",
                "destinationType": "number"
              },
              {
