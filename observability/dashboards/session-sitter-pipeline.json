    {
      "id": 30,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "sessionsitter"
      },
      "type": "barchart",
      "title": "What was refused, and why",
      "description": "A refusal is the pipeline declining to propose, and every code is a DESIGNED outcome rather than a fault: `below-floor` means a shape has not earned a rule yet, `contradicted` means a written practice already says otherwise, `never-widen` means the candidate would have generalised across an axis that is only ever narrowed. Counted per run, so a cluster refused on five runs is five.\n\nThe cluster each refusal names is a real command line and stays on the machine — `session-sitter learn --status` prints it there.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "sessionsitter"
          },
          "refId": "A",
          "expr": "kind:pipeline_run machine:~\"$machine\" refusalCount:>0 | unroll (refusals) | stats by (refusals) count() times | sort by (times desc)",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "times",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "noValue": "not recorded"
        },
        "overrides": []
